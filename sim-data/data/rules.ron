// Global simulation constants. None of these numbers may appear in a .rs file
// (CLAUDE.md, conventions).
(
    // A6: 1 tick = 1 day, 30 ticks = 1 month, 12 months = 1 year (360 ticks).
    // Scenario objectives are expressed in months/years (M1).
    ticks_per_month: 30,
    months_per_year: 12,

    starting_treasury: 1000,

    // Residents per house level. In M0 there is only one level and the value is
    // fixed: migration arrives with M1.
    residents_per_house_level: [4],

    // Thousandths of food one resident eats in one tick. With 4 residents per
    // house that makes 80 milli/house/tick: a farm producing 400 sustains 5 of
    // them, and that is exactly the capacity the farm declares — validation
    // would not let it declare any more.
    //
    // Famine is still reachable, and it is the "hunger" scenario of phase 08:
    // it happens when the houses outnumber the providers' capacity, which is
    // hunger through **lack of coverage**. A covered house, by contrast, always
    // eats.
    food_per_resident: 20,
)
