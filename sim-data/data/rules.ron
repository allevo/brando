// Global simulation constants. None of these numbers may appear in a .rs file
// (CLAUDE.md, conventions).
(
    // A6: 1 tick = 1 day, 30 ticks = 1 month, 12 months = 1 year (360 ticks).
    // Scenario objectives are expressed in months/years (M1).
    ticks_per_month: 30,
    months_per_year: 12,

    starting_treasury: 1000,

    // The house levels (phase 13). One entry per level, level 1 first, and the
    // building's `levels` in buildings.ron has to say the same number.
    //
    // Three relations are checked, not commented (sim-core
    // `DataSet::inconsistencies`): max_residents grows, decay_threshold sits
    // strictly below level_up_threshold on the same level — that band is the
    // gap — and no threshold goes past satisfaction.max.
    //
    // Level 1's two thresholds are read by nobody: nothing rises into level 1
    // and there is no level 0 to fall to. They are written as 0 so the table
    // does not claim a rule that does not exist.
    house_levels: [
        (
            // A hut: it wants water and nothing else. It is what makes the
            // first level reachable in a city that has not got a farm yet, and
            // what makes the per-level requirements do real work instead of
            // repeating the same list three times.
            max_residents: 4,
            required_services: ["water"],
            level_up_threshold: 0,
            decay_threshold: 0,
            taxable_per_resident: 0,
        ),
        (
            // From here on the house eats. At step_up 4 a served house passes
            // 50 in 13 ticks, so the level is earned inside the first month and
            // taken at the review that closes it.
            max_residents: 8,
            required_services: ["water", "food"],
            level_up_threshold: 50,
            decay_threshold: 25,
            taxable_per_resident: 0,
        ),
        (
            // The top level asks for near-perfect service: 90 is reached at tick
            // 23, so it is the second review that grants it. Losing it takes a
            // fall to 60, four ticks of missing water at step_down 8.
            max_residents: 12,
            required_services: ["water", "food"],
            level_up_threshold: 90,
            decay_threshold: 60,
            taxable_per_resident: 0,
        ),
    ],

    // How long a service has to have been arriving before the house is content
    // (phase 12). It measures time, not quantity: with capacity and output
    // consistent, a covered house always receives 100%, so "how much arrives"
    // would be a constant.
    satisfaction: (
        max: 100,
        // 25 ticks, a little under a month, from zero to the maximum.
        step_up: 4,
        // It is lost faster than it is gained: losing the water is an event,
        // getting it back is an investment.
        step_down: 8,
        // Where the bands the renderer draws begin: 25 is the lower bound of
        // Unhappy, 50 of Happy, 75 of Great, and below 25 the house is
        // Awful. Ascending and above zero, so a house at zero is always
        // Awful.
        //
        // A tuple and not a list, like `size` in buildings.ron: the arity is
        // fixed by the number of bands, so one threshold too many is a
        // deserialisation error rather than a check somebody has to write.
        mood_thresholds: (25, 50, 75),
    ),

    // Thousandths of food one resident eats in one tick. With 4 residents per
    // house that makes 80 milli/house/tick: a farm producing 400 sustains 5 of
    // them, and that is exactly the capacity the farm declares — validation
    // would not let it declare any more.
    //
    // Famine is still reachable, and it is the "hunger" scenario of phase 08:
    // it happens when the houses outnumber the providers' capacity, which is
    // hunger through **lack of coverage**. A covered house, by contrast, always
    // eats.
    food_per_resident: 20,
)
