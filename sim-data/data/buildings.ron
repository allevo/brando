// I tre edifici di M0. Un solo livello ciascuno: l'evoluzione delle case e'
// M1, e con essa raggi e capacita' diventeranno vettori di piu' elementi.
(
    buildings: [
        (
            id: "casa",
            footprint: (1, 1),
            costo: 10,
            livelli: 1,
            servizio: None,
            servizi_richiesti: ["acqua", "cibo"],
        ),
        (
            id: "pozzo",
            footprint: (1, 1),
            costo: 12,
            livelli: 1,
            servizio: Some((
                kind: "acqua",
                // Un valore per livello. Raggio in tile percorsi sulla rete
                // stradale, non in linea d'aria (D2).
                raggio_per_livello: [12],
                // Abitanti serviti contemporaneamente, non case: con i livelli
                // delle case (M1) la popolazione per casa varia. Trentadue
                // sono otto case da quattro.
                capacita_per_livello: [32],
            )),
            servizi_richiesti: [],
        ),
        (
            id: "fattoria",
            footprint: (2, 2),
            costo: 40,
            livelli: 1,
            // A5: in M0 la fattoria copre come un pozzo, consumando da una
            // giacenza locale. In M3 la merce arrivera' da un magazzino via
            // walker logistici reali e questi due campi cambieranno: il
            // raggio resta, la provenienza della merce no.
            servizio: Some((
                kind: "cibo",
                raggio_per_livello: [10],
                // Abitanti serviti contemporaneamente. Non e' un numero
                // libero: e' cio' che la produzione sostiene,
                // produzione_per_tick / consumo_cibo_per_abitante = 400 / 20 =
                // 20 abitanti, cioe' cinque case da quattro. Alzarlo
                // rimetterebbe in piedi lo stato assorbente della fame — case
                // assegnate a una fattoria che non le sfama e che nessun'altra
                // fattoria puo' rilevare. Lo verifica la validazione, non
                // questo commento: sim-core `DataSet::capacita_cibo_insostenibile`.
                capacita_per_livello: [20],
            )),
            servizi_richiesti: [],
            produzione_per_tick: Some(400),
            giacenza_max: Some(20000),
        ),
    ],
)
