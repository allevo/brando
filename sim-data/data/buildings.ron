// The three buildings of M0. The house has three levels since phase 13; the
// providers still have one each, and their ranges and capacities stay
// one-element vectors until a phase gives them levels of their own.
(
    buildings: [
        (
            id: "house",
            size: (1, 1),
            cost: 10,
            // As many as rules.house_levels has levels, and the house's area
            // stays 1x1 at every one of them: houses that merge by taking over
            // their neighbours' tiles are a whole mechanic (Zeus has it) and
            // they are M3.
            levels: 3,
            service: None,
            // The **union** of what the three levels of rules.house_levels ask
            // for, and it has to stay that: `is_house()` classifies a building
            // as a house by this list being non-empty, so a house whose
            // requirements moved entirely into the levels would stop being read
            // as one. Checked, not commented:
            // `Inconsistency::InconsistentRequirements`.
            required_services: ["water", "food"],
        ),
        (
            id: "well",
            size: (1, 1),
            cost: 12,
            levels: 1,
            service: Some((
                kind: "water",
                // One value per level. Range in tiles walked along the road
                // network, not as the crow flies (D2).
                range_per_level: [12],
                // Residents served at the same time, not houses: once houses
                // have levels (M1) the population per house varies. Thirty-two
                // is eight houses of four.
                capacity_per_level: [32],
            )),
            required_services: [],
        ),
        (
            id: "farm",
            size: (2, 2),
            cost: 40,
            levels: 1,
            // A5: in M0 the farm covers just like a well, consuming from a
            // local stock. In M3 the goods will arrive from a warehouse via
            // real logistics walkers and these two fields will change: the
            // range stays, where the goods come from does not.
            service: Some((
                kind: "food",
                range_per_level: [10],
                // Residents served at the same time. Not a free number: it is
                // what the output sustains, output_per_tick /
                // food_per_resident = 400 / 20 = 20 residents, that is five
                // houses of four. Raising it would bring back the absorbing
                // state of hunger — houses assigned to a farm that does not
                // feed them and that no other farm can take over. Validation
                // checks this, not this comment: sim-core
                // `DataSet::inconsistencies`.
                capacity_per_level: [20],
            )),
            required_services: [],
            output_per_tick: Some(400),
            max_stock: Some(20000),
        ),
    ],
)
