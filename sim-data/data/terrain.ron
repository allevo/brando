// Game properties of the terrains. The Terrain enum lives in sim-core, the
// numbers live here (D6). Every variant must be listed exactly once.
(
    terrains: [
        (terrain: Plain, buildable: true,  walkable: true,  road_cost: 2),
        (terrain: Water, buildable: false, walkable: false, road_cost: 0),
        (terrain: Rock,  buildable: false, walkable: true,  road_cost: 6),
    ],
)
