// A satisfaction curve that cannot be drawn. Two problems, both in the same
// block, so the report has to show both:
//
//   - step_down is larger than the maximum: the accumulator would go from full
//     to empty in a single tick, which is not a curve;
//   - the second mood band does not come after the first, so two bands overlap
//     and the boundary between them means nothing.
//
// The first threshold is also legitimate as it stands (25 > 0): what makes a
// satisfaction of zero always Awful is that it is above zero, and that part
// is fine here.
(
    starting_treasury: 1000,
    // A single level, matching the house in the production buildings.ron: this
    // fixture is about the satisfaction curve, and a table of levels that also disagreed
    // with the buildings table would drown the two errors it is here to show.
    // One level means level 1 only, whose thresholds are read by nobody.
    house_levels: [
        (
            max_residents: 4,
            required_services: ["water", "food"],
            level_up_threshold: 0,
            decay_threshold: 0,
            taxable_per_resident: 0,
        ),
    ],
    satisfaction: (
        max: 100,
        step_up: 4,
        step_down: 120,
        mood_thresholds: (25, 25, 75),
    ),
    food_per_resident: 20,
    // Valid, and here only because the table would not deserialise without it:
    // the faults this fixture is about are all in `satisfaction` above.
    demographics: (
        births_per_thousand_per_month: 12,
        deaths_per_thousand_per_month: 6,
        deaths_per_thousand_per_month_when_unserved: 60,
        unserved_threshold: 25,
        birth_threshold: 60,
        jitter_per_thousand: 200,
    ),
    // Valid, for the same reason as `demographics` above.
    migration: (
        satisfaction_weight: 700,
        free_places_weight: 300,
        founding_immigration_per_thousand_per_month: 30,
        founding_population_threshold: 20,
        immigration_per_thousand_per_month: 30,
        emigration_per_thousand_per_month_unhappy: 40,
        emigration_threshold: 25,
        jitter_per_thousand: 200,
    ),
)
