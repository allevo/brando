// Three distinct problems in one go: empty id, a zero in the size, and a
// producer with no stock. All three have to show up in the report.
(
    buildings: [
        (id: "", size: (0, 1), cost: 10, levels: 1, service: None, required_services: []),
        (
            id: "fattoria",
            size: (2, 2),
            cost: 40,
            levels: 1,
            service: Some((kind: "food", range_per_level: [10], capacity_per_level: [6])),
            required_services: [],
            output_per_tick: Some(400),
        ),
    ],
)
